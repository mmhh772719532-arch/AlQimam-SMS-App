<?xml version='1.0' encoding='utf-8'?>
<widget id="com.alqimam.sms" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>نظام القمم</name>
    <description>تطبيق إدارة الرسوم والإشعارات لمدارس القمم الأهلية</description>
    <author email="admin@alqimam.com" href="http://alqimam.com">
        Mohammed Hezam Al-Rajhi
    </author>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <!-- هذه الإضافة هي التي ستسمح للكود بإرسال SMS في الخلفية -->
    <plugin name="cordova-sms-plugin" spec="^1.0.0" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="33" />
    </platform>
</widget>
